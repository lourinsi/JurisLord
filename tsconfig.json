{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"strict": true,
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": ["esnext", "dom", "dom.iterable"],
		"resolveJsonModule": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true
	},
	"include": ["src", "vite.config.ts"]
}
